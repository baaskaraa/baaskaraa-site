ind":"front","w":1600,"h":1121}]}],"projects":[{"pid":"PR-2007-01","title":"37 Pearls: digital stage backdrops","subtitle":"Digital stage backdrops for the Singapore Indian Artistes' Association and Manimaran Dance Group evening at Victoria Theatre","type":"Stage collaboration","start":"2007-03-03","end":"2007-03-03","partners":"Singapore Indian Artistes' Association (SIAA) · Manimaran Dance Group","role":"Background scenery (digital stage backdrops); credited in the programme as \"பின்னணி காட்சியமைப்பு : திரு. பாஸ்கர்\"","summary":"முத்துக்கள் 37 PEARLS was an evening of Tamil theatre and dance at Victoria Theatre on Saturday 3 March 2007, presented jointly by the Singapore Indian Artistes' Association and the Manimaran Dance Group, with Dr SP Thinnappan as Guest of Honour. Baskar created the background scenery: digital stage backdrops for the programme, which included the historical play Raja Raja Chozhan, dances by the Manimaran group and the comedy 37-ம் புலிகேசி.","cover":"ae55ea140e264a2035814f00fe936444","items":[{"no":"PR-2007-01-001","stage":5,"title":"Souvenir programme, cover: முத்துக்கள் 37 PEARLS","date":"2007-03-03","kind":"document","key":false,"images":[{"id":"7540f52444b5eab27da6571b1207e2d5","w":1200,"h":1600}]},{"no":"PR-2007-01-002","stage":5,"title":"Programme credit: background scenery, Mr Baskar","date":"2007-03-03","kind":"document","key":true,"images":[{"id":"ae55ea140e264a2035814f00fe936444","w":1600,"h":1200}]},{"no":"PR-2007-01-003","stage":5,"title":"Programme: the evening's running order and cast","date":"2007-03-03","kind":"document","key":false,"images":[{"id":"bc1f37185db50fc61933c1b852e5cad4","w":1600,"h":1200}]},{"no":"PR-2007-01-004","stage":6,"title":"With Mr Rajendram and the late Mr Manimaran","date":"2007","kind":"batch","key":true,"images":[{"id":"665e44d070de84a11ea83c2e3c4a9a1e","w":1600,"h":1200}]},{"no":"PR-2007-01-005","stage":7,"title":"The backdrops were not kept","date":"2026-10-21","kind":"note","key":false,"images":[]}]},{"pid":"PR-2013-01","title":"GREY: rooftop mural for Maya Dance Theatre","subtitle":"Site-specific dance performance on the Singai Tamil Sangam rooftop, Little India","type":"Stage collaboration","start":"2013-06","end":"2013-06-22","partners":"Maya Dance Theatre (presenter) · Apsara Asia Pte Ltd (project management, marketing) · Singai Tamil Sangam (venue) · Kampong Glam Rowell Court Residents' Committee and Republic Polytechnic Indian Cultural Group (community painting) · Supporters on the promo card: Apsara Asia, Nippon Paint, Lee Foundation, Singai Tamil Sangam, arts fund, OCBC Bank","role":"Visuals and murals, with Charlie Lim (credited in the programme as 'Ka Baskar'); promotional video made by Baskar in support of the event","summary":"GREY was a Maya Dance Theatre production staged on the rooftop of Singai Tamil Sangam, 02 Kampong Kapor Road, Little India, from 19 to 22 June 2013 at 8 pm. The programme credits the visuals and murals to Charlie Lim and Ka. Baskar: the rooftop walls, stairhouse and parapets were painted as a mural that became the environment for the dance, with members of the Kampong Glam Rowell Court Residents' Committee and students from the Republic Polytechnic Indian Cultural Group painting alongside. Baskar also made a promotional video in support of the event.","cover":"b0f39fef4724d3ecb1778223ae33ccbc","items":[{"no":"PR-2013-01-004","stage":4,"title":"Group photo with dancers and volunteers","date":"2013-06","kind":"batch","key":false,"images":[{"id":"6f380a0a354b6b90352eca23d5ec5896","w":960,"h":717}]},{"no":"PR-2013-01-012","stage":4,"title":"Baskar and Charlie Lim preparing the mural","date":"2013-06","kind":"batch","key":true,"images":[{"id":"b0f39fef4724d3ecb1778223ae33ccbc","w":1400,"h":931},{"id":"c2a006cdfb473e68a047948f38d28443","w":1400,"h":935},{"id":"c356a6d28de7b8a3b873c79c7aafe89d","w":1400,"h":1051}]},{"no":"PR-2013-01-005","stage":5,"title":"GREY promo video","date":"2013-06-14","kind":"video","key":true,"images":[{"id":"3732464335706ca3d8a3ebf4ae63f09f","w":1400,"h":875},{"id":"3102690401fd211def284808d8ac1889","w":1400,"h":875}]},{"no":"PR-2013-01-006","stage":5,"title":"Title, date and sponsor cards","date":"2013-06-14","kind":"document","key":false,"images":[{"id":"3732464335706ca3d8a3ebf4ae63f09f","w":1400,"h":875},{"id":"3102690401fd211def284808d8ac1889","w":1400,"h":875},{"id":"10108e1bd16b25a96ec96c9a0a5a3f75","w":1400,"h":875},{"id":"a5c94a80a7012dca68ecc65a538869d4","w":1400,"h":875}]},{"no":"PR-2013-01-011","stage":5,"title":"Printed programme: GREY","date":"2013-06-19","kind":"document","key":true,"images":[{"id":"264074fb22ce585fb14fbd1f12f7c646","w":1162,"h":1600},{"id":"3f1620ce54a204a5b6d1e06b1ce65967","w":1171,"h":1600},{"id":"e28dc44a78e9928e402ce87b27de000d","w":1600,"h":1155}]}]},{"pid":"PR-2014-01","title":"Project LAVA: Bird Sanctum","subtitle":"A Tamil novel turned into an installation for the NAC–NLB Project LAVA in the Libraries","type":"Public commission","start":"2013-11","end":"2014-10","partners":"National Arts Council (NAC) · National Library Board (NLB)","role":"Appointed LAVA artist (Tamil): proposal, design, making, installation at four libraries, public talk","summary":"Bird Sanctum was one of four artworks chosen for the second Project LAVA in the Libraries, the NAC and NLB programme that pairs Singapore writing with visual art. It turned Ma Ilangkannan's Tamil novel Kuruvi Kottam into an installation of white birds around a nest that stands for home, on a pedestal in the shape of Singapore, and it travelled to four public libraries from May to August 2014.","cover":"473563a99bb3596d531c687239537540","items":[{"no":"PR-2014-01-001","stage":1,"title":"First meeting with the author, Karikalan awards night, Kuala Lumpur","date":"2011","kind":"note","key":false,"images":[{"id":"89c1333ad924004f4dc8190cc6586d3e","w":910,"h":1287}]},{"no":"PR-2014-01-009","stage":4,"title":"The author's studio visit and the walk at MacRitchie","date":"2014-03","k